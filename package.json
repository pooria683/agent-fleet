{
  "name": "agent-fleet",
  "version": "0.1.0",
  "description": "A local-first workbench for running, observing, and comparing coding agents in isolated Git worktrees.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pooria683/agent-fleet.git"
  },
  "bugs": {
    "url": "https://github.com/pooria683/agent-fleet/issues"
  },
  "homepage": "https://github.com/pooria683/agent-fleet#readme",
  "keywords": [
    "cli",
    "coding-agents",
    "git-worktree",
    "tui",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "bin": {
    "agent-fleet": "dist/cli/index.js"
  },
  "main": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli/index.js', 0o755)\"",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "demo": "npm run build && node scripts/demo.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "14.0.3",
    "execa": "9.6.1",
    "ink": "6.8.0",
    "proper-lockfile": "4.1.2",
    "react": "19.2.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "@types/react": "19.2.7",
    "@vitest/coverage-v8": "5.1.0",
    "ink-testing-library": "4.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
